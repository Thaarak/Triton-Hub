# Leave blank to run the public demo without a Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for Vercel production and for explicit OAuth callback origin.
NEXT_PUBLIC_SITE_URL=

# Required for live Canvas and Gmail connections. Server only.
SUPABASE_SERVICE_ROLE_KEY=
# Generate with openssl rand -hex 32. Keep the same value between deployments.
INTEGRATION_ENCRYPTION_KEY=

# Optional, server-only credentials for the separate Gmail OAuth connection.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
